{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals", "vite/client"],
    "paths": {
      "@agentrecall/workspace-core": ["../../packages/workspace-core/src/index.ts"],
      "zod": ["./node_modules/zod"],
      "yaml": ["./node_modules/yaml"],
      "proper-lockfile": ["./node_modules/@types/proper-lockfile/index.d.ts"]
    }
  },
  "include": ["electron.vite.config.ts", "src/**/*.ts", "src/**/*.tsx"]
}
