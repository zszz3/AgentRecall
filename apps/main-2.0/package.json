{
  "name": "agent-recall",
  "productName": "AgentRecall",
  "version": "2.0.0",
  "private": true,
  "description": "Desktop console for searching, tagging, and resuming AI agent coding sessions.",
  "license": "MIT",
  "main": "out/main/index.js",
  "type": "module",
  "bin": {
    "agent-recall": "bin/agent-recall.cjs",
    "agentrecall": "bin/agent-recall.cjs",
    "agent-recall-claude-statusline": "bin/claude-statusline-snapshot.cjs",
    "agent-recall-setup-claude-statusline": "bin/setup-claude-statusline.cjs",
    "agent-recall-skill-usage": "bin/skill-usage-record.cjs",
    "agent-recall-setup-skill-usage-hook": "bin/setup-skill-usage-hook.cjs",
    "agent-recall-session-sync": "bin/session-sync-record.cjs",
    "agent-recall-setup-session-sync-hook": "bin/setup-session-sync-hook.cjs",
    "agent-recall-mcp": "bin/agent-recall-mcp.mjs",
    "agent-recall-skill-mcp": "bin/agent-recall-skill-mcp.mjs",
    "agent-recall-eval-mcp": "bin/agent-recall-eval-mcp.mjs",
    "agent-recall-setup-mcp": "bin/setup-mcp.cjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "out/main",
    "out/preload",
    "out/renderer",
    "out/mcp/*.js",
    "out/cli/*.js",
    "dist/main/index.js",
    "bin",
    "assets/app-icon.png",
    "assets/tray-icon-template.svg",
    "assets/tray-iconTemplate*.png",
    "assets/bundled-skills",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "predev": "node ../../scripts/windows-dev-environment.mjs && node ../../scripts/ensure-electron-runtime.mjs .",
    "dev": "npm run build:mcp && npm run build:cli && electron-vite dev",
    "build": "npm run typecheck && npm run build:mcp && npm run build:cli && electron-vite build",
    "typecheck": "tsc --noEmit && npm run check:dead-code",
    "check:dead-code": "node scripts/check-source-entrypoints.mjs",
    "test": "vitest run && npm run test:scripts && npm run test:cli",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:cli": "npm run build:cli && node scripts/run-cli-tests.mjs",
    "test:headless": "node scripts/session-backend-smoke.mjs",
    "test:watch": "vitest",
    "package:smoke": "npm run build && node scripts/package-smoke.mjs",
    "release-note:check": "node scripts/release-notes.mjs check-range",
    "prepare": "npm run build:mcp && npm run build:cli && electron-vite build",
    "build:mcp": "node scripts/build-mcp-bundle.mjs",
    "build:cli": "node scripts/build-cli-bundle.mjs",
    "package:rc:macos": "npm run build && node scripts/package-release-macos.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.2.1",
    "@anthropic-ai/claude-agent-sdk": "^0.3.216",
    "@anthropic-ai/claude-code": "^2.1.216",
    "@babel/parser": "^7.29.7",
    "@earendil-works/pi-ai": "^1.5.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "42.9.2",
    "electron-store": "^10.0.1",
    "jsonrepair": "3.15.0",
    "lucide-react": "^0.468.0",
    "proper-lockfile": "^4.1.2",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "read-cmd-shim": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.9.0",
    "ssh2": "1.17.0",
    "tailwind-merge": "^3.7.1",
    "tar": "^7.5.21",
    "which": "^6.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.10.2",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ssh2": "1.15.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron-vite": "^3.1.0",
    "esbuild": "^0.25.12",
    "happy-dom": "^20.11.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
