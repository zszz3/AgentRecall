{
  "name": "agent-recall-v2",
  "productName": "agent-recall-v2",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop console for searching, tagging, and resuming AI agent coding sessions.",
  "license": "MIT",
  "main": "out/main/index.js",
  "type": "module",
  "bin": {
    "agent-recall-v2": "bin/agent-recall.cjs",
    "agent-recall-v2-claude-statusline": "bin/claude-statusline-snapshot.cjs",
    "agent-recall-v2-setup-claude-statusline": "bin/setup-claude-statusline.cjs",
    "agent-recall-v2-skill-usage": "bin/skill-usage-record.cjs",
    "agent-recall-v2-setup-skill-usage-hook": "bin/setup-skill-usage-hook.cjs",
    "agent-recall-v2-session-sync": "bin/session-sync-record.cjs",
    "agent-recall-v2-setup-session-sync-hook": "bin/setup-session-sync-hook.cjs",
    "agent-recall-v2-openviking-memory-hook": "bin/openviking-memory-hook.cjs",
    "agent-recall-v2-setup-openviking-memory-hooks": "bin/setup-openviking-memory-hooks.cjs",
    "agent-recall-v2-mcp": "bin/agent-recall-mcp.mjs",
    "agent-recall-v2-skill-mcp": "bin/agent-recall-skill-mcp.mjs",
    "agent-recall-v2-workflow-mcp": "bin/agent-recall-workflow-mcp.mjs",
    "agent-recall-v2-setup-mcp": "bin/setup-mcp.cjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "out/main",
    "out/preload",
    "out/renderer",
    "out/mcp/*.js",
    "dist/main/index.js",
    "bin",
    "assets",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "predev": "node ../../scripts/ensure-electron-runtime.mjs .",
    "dev": "npm run build:mcp && electron-vite dev",
    "build": "npm run typecheck && npm run build:mcp && electron-vite build",
    "typecheck": "tsc --noEmit && npm run check:dead-code",
    "check:dead-code": "node scripts/check-source-entrypoints.mjs",
    "test": "vitest run && npm run test:scripts",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:workflow-performance": "vitest run src/automation/engine/main/hub/agent-hub.test.ts src/automation/engine/main/workflows/v2/workflow-v2-conversation-manager.test.ts src/main/services/automation-service.test.ts",
    "test:workflow-transaction": "vitest run src/automation/engine/shared/workflow-v2 src/automation/engine/main/workflows/v2 src/automation/engine/main/workflows/workflow-runtime.test.ts src/automation/engine/main/hub/agent-hub-workflow-activation.test.ts src/automation/engine/main/hub/workflow/agent-hub-workflow-clone.test.ts src/automation/engine/main/hub/workflow/agent-hub-workflow-restore.test.ts src/automation/engine/main/hub/workflow/agent-hub-workflow-v2.test.ts",
    "test:watch": "vitest",
    "package:smoke": "npm run build && node scripts/package-smoke.mjs",
    "release:preflight:openviking": "node scripts/verify-openviking-runtime-inputs.mjs",
    "release-note:check": "node scripts/release-notes.mjs check-range",
    "postinstall": "node bin/embedded-postgres-runtime.cjs",
    "prepare": "npm run build:mcp && electron-vite build",
    "build:mcp": "node scripts/build-mcp-bundle.mjs",
    "build:openviking-runtime": "node scripts/build-openviking-runtime.mjs"
  },
  "dependencies": {
    "@babel/parser": "^7.29.7",
    "@agentclientprotocol/sdk": "^1.2.1",
    "@anthropic-ai/claude-agent-sdk": "^0.3.216",
    "@anthropic-ai/claude-code": "^2.1.216",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openviking/sdk": "^0.1.0",
    "@xyflow/react": "^12.11.2",
    "electron": "42.9.2",
    "electron-store": "^10.0.1",
    "embedded-postgres": "18.4.0-beta.17",
    "lucide-react": "^0.468.0",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "read-cmd-shim": "^5.0.0",
    "ssh2": "1.17.0",
    "tar": "^7.5.21",
    "which": "^6.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@embedded-postgres/darwin-arm64": "18.4.0-beta.17",
    "@embedded-postgres/darwin-x64": "18.4.0-beta.17",
    "@embedded-postgres/linux-arm": "18.4.0-beta.17",
    "@embedded-postgres/linux-arm64": "18.4.0-beta.17",
    "@embedded-postgres/linux-ia32": "18.4.0-beta.17",
    "@embedded-postgres/linux-ppc64": "18.4.0-beta.17",
    "@embedded-postgres/linux-x64": "18.4.0-beta.17",
    "@embedded-postgres/windows-x64": "18.4.0-beta.17"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ssh2": "1.15.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron-vite": "^3.1.0",
    "esbuild": "^0.25.12",
    "happy-dom": "^20.11.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
